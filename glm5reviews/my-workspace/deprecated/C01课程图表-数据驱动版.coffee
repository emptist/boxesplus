# ============================================
# 数据驱动生成器
# ============================================

从数据生成图表 = (数据) ->
  switch 数据.类型
    when "流程图"
      图表 = 创建流程图 数据.标题
      if 数据.方向
        图表.设置方向 数据.方向
      if 数据.节点
        for 节点 in 数据.节点
          图表.添加节点 节点.id, 节点.文本, 节点.样式
      if 数据.子图
        for 子图 in 数据.子图
          图表.添加子图 子图.标题, 子图.节点
      if 数据.连接
        for 连接 in 数据.连接
          图表.添加连接 连接.从, 连接.到, 连接.标签, 连接.样式
      图表
    
    when "时序图"
      图表 = 创建时序图 数据.标题
      if 数据.参与者
        for 参与者 in 数据.参与者
          图表.添加参与者 参与者.名称, 参与者.角色
      if 数据.消息
        for 消息 in 数据.消息
          图表.添加消息 消息.从, 消息.到, 消息.文本, 消息.类型
      图表
    
    when "类图"
      图表 = 创建类图 数据.标题
      if 数据.类定义
        for 类 in 数据.类定义
          图表.添加类 类.名称, 类.属性, 类.方法
      if 数据.关系
        for 关系 in 数据.关系
          图表.添加关系 关系.从, 关系.到, 关系.类型
      图表
    
    when "状态图"
      图表 = 创建状态图 数据.标题
      if 数据.状态
        for 状态 in 数据.状态
          图表.添加状态 状态.名称, 状态.类型
      if 数据.转换
        for 转换 in 数据.转换
          图表.添加转换 转换.从, 转换.到, 转换.事件
      图表

# ============================================
# 批量生成
# ============================================

绘图 = 开始绘图 "C01医疗质量与安全管理课程图表集（数据驱动版）"

for 名称, 数据 of 图表数据
  图表 = 从数据生成图表 数据
  绘图.添加 图表

完成绘图 "../output/C01课程图表-数据驱动版.md"
