#!/usr/bin/env coffee

# C01课程图表 - PPTX/HTML版
# 使用诗式风格生成PPTX和HTML格式

{ 开始绘图PPTX, 开始绘图HTML, 开始绘图简化HTML, 完成绘图, 图, 创建流程图, 创建时序图, 创建类图, 创建状态图 } = require "../api/mermaid-enhanced-v2.coffee"

# ============================================
# 诗式风格：生成PPTX
# ============================================

绘图PPTX = 开始绘图PPTX "C01医疗质量与安全管理课程图表（PPTX版）"

# PDCA循环
PDCA图 = 创建流程图 "PDCA循环"
PDCA图.设置方向 "TD"
PDCA图.添加节点 "P", "PLAN（计划）", 形状: "圆角"
PDCA图.添加节点 "D", "DO（执行）", 形状: "圆角"
PDCA图.添加节点 "C", "CHECK（检查）", 形状: "圆角"
PDCA图.添加节点 "A", "ACTION（处理）", 形状: "圆角"
PDCA图.添加连接 "P", "D"
PDCA图.添加连接 "D", "C"
PDCA图.添加连接 "C", "A"
PDCA图.添加连接 "A", "P", "持续改进"

绘图PPTX.添加图表 PDCA图

# 质量管理体系
体系图 = 创建流程图 "医疗质量管理体系"
体系图.设置方向 "TB"

体系图.添加子图 "顶层设计", [
  { id: "方针", 文本: "质量方针" }
  { id: "目标", 文本: "质量目标" }
  { id: "文化", 文本: "质量文化" }
]

体系图.添加子图 "组织保障", [
  { id: "组织", 文本: "质量组织" }
  { id: "制度", 文本: "质量制度" }
  { id: "流程", 文本: "质量流程" }
]

体系图.添加子图 "执行控制", [
  { id: "控制", 文本: "质量控制" }
  { id: "保证", 文本: "质量保证" }
  { id: "改进", 文本: "质量改进" }
]

体系图.添加连接 "方针", "组织"
体系图.添加连接 "目标", "制度"
体系图.添加连接 "文化", "流程"
体系图.添加连接 "组织", "控制"
体系图.添加连接 "制度", "保证"
体系图.添加连接 "流程", "改进"

绘图PPTX.添加图表 体系图

# 不良事件管理
事件图 = 创建流程图 "不良事件闭环管理"
事件图.设置方向 "TD"

事件图.添加节点 "报告", "1.事件报告", 形状: "圆角"
事件图.添加节点 "调查", "2.初步调查", 形状: "圆角"
事件图.添加节点 "分析", "3.根本原因分析", 形状: "菱形"
事件图.添加节点 "改进", "4.改进措施", 形状: "圆角"
事件图.添加节点 "评估", "5.效果评估", 形状: "圆角"
事件图.添加节点 "标准", "6.标准化", 形状: "圆柱"

事件图.添加连接 "报告", "调查"
事件图.添加连接 "调查", "分析"
事件图.添加连接 "分析", "改进"
事件图.添加连接 "改进", "评估"
事件图.添加连接 "评估", "标准"

绘图PPTX.添加图表 事件图

# 危急值管理
危急值图 = 创建时序图 "危急值管理流程"
危急值图.添加参与者 "检验科", "系统"
危急值图.添加参与者 "临床科室", "科室"
危急值图.添加参与者 "质控部门", "质控"

危急值图.添加消息 "检验科", "临床科室", "检测到危急值", "同步"
危急值图.添加消息 "临床科室", "检验科", "确认接收", "返回"
危急值图.添加消息 "临床科室", "质控部门", "上报处理措施", "同步"
危急值图.添加消息 "质控部门", "临床科室", "审核确认", "返回"

绘图PPTX.添加图表 危急值图

# 质量管理组织
组织图 = 创建类图 "质量管理组织架构"

组织图.添加类 "质量委员会", ["主席", "委员"], ["制定方针", "审核目标"]
组织图.添加类 "质控部门", ["主任", "质控员"], ["日常监督", "数据分析"]
组织图.添加类 "科室质控组", ["组长", "成员"], ["科室自查", "问题整改"]
组织图.添加类 "全院职工", ["医师", "护士"], ["执行规范", "报告事件"]

组织图.添加关系 "质量委员会", "质控部门", "关联"
组织图.添加关系 "质控部门", "科室质控组", "关联"
组织图.添加关系 "科室质控组", "全院职工", "关联"

绘图PPTX.添加图表 组织图

# 安全风险管理
风险图 = 创建状态图 "患者安全风险管理"

风险图.添加状态 "正常", "普通"
风险图.添加状态 "风险评估", "普通"
风险图.添加状态 "高风险", "普通"
风险图.添加状态 "干预措施", "普通"
风险图.添加状态 "安全", "结束"

风险图.添加转换 "正常", "风险评估", "定期评估"
风险图.添加转换 "风险评估", "高风险", "发现风险"
风险图.添加转换 "高风险", "干预措施", "启动干预"
风险图.添加转换 "干预措施", "安全", "风险消除"
风险图.添加转换 "安全", "正常", "恢复常态"

绘图PPTX.添加图表 风险图

# 保存PPTX
完成绘图 "../output/C01课程图表-PPTX版.pptx"

# ============================================
# 诗式风格：生成HTML（RevealJS）
# ============================================

绘图HTML = 开始绘图HTML "C01医疗质量与安全管理课程图表（HTML版）"

# 重复添加相同的图表
绘图HTML.添加图表 PDCA图
绘图HTML.添加图表 体系图
绘图HTML.添加图表 事件图
绘图HTML.添加图表 危急值图
绘图HTML.添加图表 组织图
绘图HTML.添加图表 风险图

# 保存HTML
完成绘图 "../output/C01课程图表-HTML版.html"

# ============================================
# 诗式风格：生成简化HTML
# ============================================

绘图简化HTML = 开始绘图简化HTML "C01医疗质量与安全管理课程图表（简化HTML版）"

# 重复添加相同的图表
绘图简化HTML.添加图表 PDCA图
绘图简化HTML.添加图表 体系图
绘图简化HTML.添加图表 事件图
绘图简化HTML.添加图表 危急值图
绘图简化HTML.添加图表 组织图
绘图简化HTML.添加图表 风险图

# 保存简化HTML
完成绘图 "../output/C01课程图表-简化HTML版.html"
