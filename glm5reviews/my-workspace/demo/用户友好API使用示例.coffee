    标题: "患者就诊流程"
    内容: [
      {
        发送者: "患者"
        接收者: "挂号处"
        消息: "挂号"
      }
      {
        发送者: "挂号处"
        接收者: "患者"
        消息: "挂号成功"
      }
      {
        发送者: "患者"
        接收者: "医生"
        消息: "就诊"
      }
      {
        发送者: "医生"
        接收者: "患者"
        消息: "开具处方"
      }
      {
        发送者: "患者"
        接收者: "药房"
        消息: "取药"
      }
    ]
    说明: "患者从挂号到取药的完整流程"
  }
  .完成 "output/示例2-患者就诊流程.html"

