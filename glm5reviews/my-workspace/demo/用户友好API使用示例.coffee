#!/usr/bin/env coffee

# Mermaid图表生成器 - 用户友好API使用示例
# 展示如何使用API生成各种图表，无需编程知识

{ 开始绘图, 添加图表, 完成绘图, 流程图, 时序图, 类图, 状态图 } = require "../api/mermaid-user-friendly.coffee"

# ============================================
# 示例1：流程图
# ============================================

演示1 = 开始绘图 "医疗质量管理流程"

演示1
  .添加图表 流程图 {
    标题: "医疗质量管理流程"
    内容: [
      "制定质量目标"
      "建立质量管理体系"
      "实施质量监控"
      "质量评估与改进"
      "持续改进"
    ]
    说明: "这是一个持续改进的循环流程"
  }
  .完成 "output/示例1-医疗质量管理流程.html"

# ============================================
# 示例2：时序图
# ============================================

演示2 = 开始绘图 "患者就诊流程"

演示2
