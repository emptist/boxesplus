# ============================================
# 示例4：状态图
# ============================================

演示4 = 开始绘图 "患者就诊状态图"

演示4
  .添加图表 状态图 {
    标题: "患者就诊状态图"
    内容: [
      {
        名称: "待诊"
        初始: true
        转换: [
          {
            目标: "就诊中"
            标签: "叫号"
          }
        ]
      }
      {
        名称: "就诊中"
        转换: [
          {
            目标: "待缴费"
            标签: "诊断完成"
          }
        ]
      }
      {
        名称: "待缴费"
        转换: [
          {
            目标: "待取药"
            标签: "缴费完成"
          }
        ]
      }
      {
        名称: "待取药"
        转换: [
          {
            目标: "完成"
            标签: "取药完成"
          }
        ]
      }
    ]
    说明: "患者就诊的各个状态转换"
  }
  .完成 "output/示例4-患者就诊状态图.html"

