#!/usr/bin/env coffee

# Mermaid增强版ASCII框图生成器
# 参考主项目的诗式和双侧编程风格，提供优雅的图表生成API

fs = require "fs"

# ============================================
# 全局状态
# ============================================

当前图表 = null
图表编号 = 0

# ============================================
# 诗式API：像写诗一样创建图表
# ============================================

图 = (内容...) ->
  图表编号++
  
  if 内容.length == 1
    if typeof 内容[0] == "string"
      创建流程图 内容[0]
    else if typeof 内容[0] == "object"
      解析图表对象 内容[0]
  
  else if 内容.length == 2
    [类型, 定义] = 内容
    创建图表 类型, 定义

开始绘图 = (标题) ->
  当前图表 = new 图表容器 标题
  图表编号 = 0
  console.log "🎨 开始绘图：#{标题}"
  当前图表

完成绘图 = (文件名) ->
  if 当前图表
    当前图表.保存 文件名
  else
    console.log "⚠️  没有活动的图表"

# ============================================
# 图表容器类
# ============================================

class 图表容器
  constructor: (@标题) ->
    @图表列表 = []
  
  添加: (图表) ->
    @图表列表.push 图表
    this
  
  保存: (文件名) ->
    内容 = @生成内容()
    fs.writeFileSync 文件名, 内容, "utf-8"
    console.log "✅ 绘图完成：#{文件名}"
    console.log "   共 #{@图表列表.length} 个图表"
  
  生成内容: ->
    输出 = []
    输出.push "# #{@标题}\n"
    
    for 图表 in @图表列表
      输出.push "## #{图表.标题}\n"
      输出.push "```mermaid\n"
      输出.push 图表.生成Mermaid()
      输出.push "```\n"
      输出.push "\n"
      
      if 图表.增强ASCII
        输出.push "### ASCII增强版\n"
        输出.push "```\n"
        输出.push 图表.生成ASCII()
        输出.push "```\n\n"
    
    输出.join ""

# ============================================
# 图表基类
# ============================================

class 图表基类
  constructor: (@标题, @类型) ->
    @节点 = []
    @连接 = []
    @子图 = []
    @样式 = {}
    @增强ASCII = true
  
  添加节点: (id, 文本, 样式 = {}) ->
    @节点.push { id, 文本, 样式 }
    this
  
  添加连接: (从, 到, 标签 = "", 样式 = {}) ->
    @连接.push { 从, 到, 标签, 样式 }
    this
  
  添加子图: (标题, 节点列表) ->
    @子图.push { 标题, 节点: 节点列表 }
    this
  
  生成Mermaid: ->
    ""
  
  生成ASCII: ->
    ""

# ============================================
# 流程图类
# ============================================

class 流程图 extends 图表基类
  constructor: (标题) ->
    super 标题, "flowchart"
    @方向 = "TD"
  
  设置方向: (方向) ->
    @方向 = 方向
    this
  
  生成Mermaid: ->
    输出 = []
    输出.push "flowchart #{@方向}\n"
    
    for 子图 in @子图
      输出.push "subgraph #{子图.标题}\n"
      for 节点 in 子图.节点
        if typeof 节点 == "string"
          输出.push "  #{节点}[#{节点}]\n"
        else
          输出.push "  #{节点.id}[#{节点.文本}]\n"
      输出.push "end\n"
    
    for 节点 in @节点
      if 节点.样式.形状 == "圆角"
        输出.push "#{节点.id}(#{节点.文本})\n"
      else if 节点.样式.形状 == "菱形"
        输出.push "#{节点.id}{#{节点.文本}}\n"
      else if 节点.样式.形状 == "圆柱"
        输出.push "#{节点.id}[(#{节点.文本})]\n"
      else if 节点.样式.形状 == "parallelogram"
        输出.push "#{节点.id}[/#{节点.文本}/]\n"
      else
        输出.push "#{节点.id}[#{节点.文本}]\n"
    
    for 连接 in @连接
      if 连接.标签
        输出.push "#{连接.从} -->|#{连接.标签}| #{连接.到}\n"
      else
        输出.push "#{连接.从} --> #{连接.到}\n"
    
    输出.join ""
  
  生成ASCII: ->
    输出 = []
    输出.push "┌─────────────────────────────────────┐\n"
    输出.push "│         #{@标题.padEnd 30}│\n"
    输出.push "└─────────────────────────────────────┘\n\n"
    
    for 节点, 索引 in @节点
      输出.push "  ┌─────────────────────┐\n"
      输出.push "  │ #{节点.文本.padEnd 19}│\n"
      输出.push "  └─────────────────────┘\n"
      
      if 索引 < @连接.length
        连接 = @连接[索引]
        if 连接.标签
          输出.push "           │\n"
          输出.push "           ↓ #{连接.标签}\n"
        else
          输出.push "           │\n"
          输出.push "           ↓\n"
    
    输出.join ""

# ============================================
# 时序图类
# ============================================

class 时序图 extends 图表基类
  constructor: (标题) ->
    super 标题, "sequence"
    @参与者 = []
    @消息 = []
  
  添加参与者: (名称, 角色 = "") ->
    @参与者.push { 名称, 角色 }
    this
  
  添加消息: (从, 到, 文本, 类型 = "同步") ->
    @消息.push { 从, 到, 文本, 类型 }
    this
  
  生成Mermaid: ->
    输出 = []
    输出.push "sequenceDiagram\n"
    
    for 参与者 in @参与者
      if 参与者.角色
        输出.push "participant #{参与者.角色} as #{参与者.名称}\n"
      else
        输出.push "participant #{参与者.名称}\n"
    
    for 消息 in @消息
      if 消息.类型 == "同步"
        输出.push "#{消息.从}->>#{消息.到}: #{消息.文本}\n"
      else if 消息.类型 == "异步"
        输出.push "#{消息.从}->#{消息.到}: #{消息.文本}\n"
      else if 消息.类型 == "返回"
        输出.push "#{消息.从}-->>#{消息.到}: #{消息.文本}\n"
      else if 消息.类型 == "dashed"
        输出.push "#{消息.从}-->>#{消息.到}: #{消息.文本}\n"
    
    输出.join ""
  
  生成ASCII: ->
    输出 = []
    输出.push "┌─────────────────────────────────────┐\n"
    输出.push "│         #{@标题.padEnd 30}│\n"
    输出.push "└─────────────────────────────────────┘\n\n"
    
    if @参与者.length > 0
      宽度 = Math.floor 60 / @参与者.length
      头部 = ""
      分隔 = ""
      
      for 参与者, 索引 in @参与者
        头部 += "│ #{参与者.名称.padEnd(宽度 - 3)}"
        分隔 += "├#{'─'.repeat(宽度 - 1)}"
      头部 += "│\n"
      分隔 += "┤\n"
      
      输出.push 头部
      输出.push 分隔
      
      for 消息 in @消息
        输出.push "│ #{消息.文本.padEnd 57}│\n"
        输出.push "│ #{('↓ ' + 消息.从 + ' → ' + 消息.到).padEnd 57}│\n"
        输出.push 分隔
    
    输出.join ""

# ============================================
# 类图类
# ============================================

class 类图 extends 图表基类
  constructor: (标题) ->
    super 标题, "class"
    @类定义 = []
    @关系 = []
  
  添加类: (名称, 属性 = [], 方法 = []) ->
    @类定义.push { 名称, 属性, 方法 }
    this
  
  添加关系: (从, 到, 类型 = "关联") ->
    @关系.push { 从, 到, 类型 }
    this
  
  生成Mermaid: ->
    输出 = []
    输出.push "classDiagram\n"
    
    for 类 in @类定义
      输出.push "class #{类.名称}{\n"
      for 属性 in 类.属性
        输出.push "  #{属性}\n"
      for 方法 in 类.方法
        if 方法.endsWith "()"
          输出.push "  #{方法}\n"
        else
          输出.push "  #{方法}()\n"
      输出.push "}\n"
    
    for 关系 in @关系
      if 关系.类型 == "继承"
        输出.push "#{关系.从} <|-- #{关系.到}\n"
      else if 关系.类型 == "实现"
        输出.push "#{关系.从} <|.. #{关系.到}\n"
      else if 关系.类型 == "组合"
        输出.push "#{关系.从} *-- #{关系.到}\n"
      else if 关系.类型 == "聚合"
        输出.push "#{关系.从} o-- #{关系.到}\n"
      else
        输出.push "#{关系.从} --> #{关系.到}\n"
    
    输出.join ""
  
  生成ASCII: ->
    输出 = []
    输出.push "┌─────────────────────────────────────┐\n"
    输出.push "│         #{@标题.padEnd 30}│\n"
    输出.push "└─────────────────────────────────────┘\n\n"
    
    for 类 in @类定义
      输出.push "  ┌─────────────────────────┐\n"
      输出.push "  │ #{类.名称.padEnd 23}│\n"
      输出.push "  ├─────────────────────────┤\n"
      for 属性 in 类.属性
        输出.push "  │ #{属性.padEnd 23}│\n"
      if 类.属性.length > 0 and 类.方法.length > 0
        输出.push "  ├─────────────────────────┤\n"
      for 方法 in 类.方法
        if 方法.endsWith "()"
          输出.push "  │ #{方法.padEnd 23}│\n"
        else
          输出.push "  │ #{方法 + "()".padEnd 23}│\n"
      输出.push "  └─────────────────────────┘\n\n"
    
    输出.join ""

# ============================================
# 状态图类
# ============================================

class 状态图 extends 图表基类
  constructor: (标题) ->
    super 标题, "state"
    @状态 = []
    @转换 = []
  
  添加状态: (名称, 类型 = "普通") ->
    @状态.push { 名称, 类型 }
    this
  
  添加转换: (从, 到, 事件 = "") ->
    @转换.push { 从, 到, 事件 }
    this
  
  生成Mermaid: ->
    输出 = []
    输出.push "stateDiagram-v2\n"
    
    for 状态 in @状态
      if 状态.类型 == "开始"
        输出.push "[*] --> #{状态.名称}\n"
      else if 状态.类型 == "结束"
        输出.push "#{状态.名称} --> [*]\n"
      else
        输出.push "#{状态.名称}\n"
    
    for 转换 in @转换
      if 转换.事件
        输出.push "#{转换.从} --> #{转换.到}: #{转换.事件}\n"
      else
        输出.push "#{转换.从} --> #{转换.到}\n"
    
    输出.join ""
  
  生成ASCII: ->
    输出 = []
    输出.push "┌─────────────────────────────────────┐\n"
    输出.push "│         #{@标题.padEnd 30}│\n"
    输出.push "└─────────────────────────────────────┘\n\n"
    
    for 状态, 索引 in @状态
      if 状态.类型 == "开始"
        输出.push "  (开始) "
      else if 状态.类型 == "结束"
        输出.push "  (结束) "
      else
        输出.push "  [#{状态.名称}] "
      
      if 索引 < @转换.length
        转换 = @转换[索引]
        if 转换.事件
          输出.push "-- #{转换.事件} --> "
        else
          输出.push "---> "
    
    输出.push "\n"
    输出.join ""

# ============================================
# 便捷函数
# ============================================

创建流程图 = (标题) ->
  new 流程图 标题

创建时序图 = (标题) ->
  new 时序图 标题

创建类图 = (标题) ->
  new 类图 标题

创建状态图 = (标题) ->
  new 状态图 标题

创建图表 = (类型, 定义) ->
  switch 类型
    when "流程图" then 创建流程图 定义
    when "时序图" then 创建时序图 定义
    when "类图" then 创建类图 定义
    when "状态图" then 创建状态图 定义
    else 创建流程图 定义

解析图表对象 = (对象) ->
  switch 对象.类型
    when "流程图"
      图表 = 创建流程图 对象.标题
      if 对象.方向
        图表.设置方向 对象.方向
      if 对象.节点
        for 节点 in 对象.节点
          图表.添加节点 节点.id, 节点.文本, 节点.样式
      if 对象.连接
        for 连接 in 对象.连接
          图表.添加连接 连接.从, 连接.到, 连接.标签, 连接.样式
      图表
    when "时序图"
      图表 = 创建时序图 对象.标题
      if 对象.参与者
        for 参与者 in 对象.参与者
          图表.添加参与者 参与者.名称, 参与者.角色
      if 对象.消息
        for 消息 in 对象.消息
          图表.添加消息 消息.从, 消息.到, 消息.文本, 消息.类型
      图表
    when "类图"
      图表 = 创建类图 对象.标题
      if 对象.类定义
        for 类 in 对象.类定义
          图表.添加类 类.名称, 类.属性, 类.方法
      if 对象.关系
        for 关系 in 对象.关系
          图表.添加关系 关系.从, 关系.到, 关系.类型
      图表
    when "状态图"
      图表 = 创建状态图 对象.标题
      if 对象.状态
        for 状态 in 对象.状态
          图表.添加状态 状态.名称, 状态.类型
      if 对象.转换
        for 转换 in 对象.转换
          图表.添加转换 转换.从, 转换.到, 转换.事件
      图表

# ============================================
# 导出
# ============================================

module.exports = {
  开始绘图
  完成绘图
  图
  创建流程图
  创建时序图
  创建类图
  创建状态图
  流程图
  时序图
  类图
  状态图
  图表容器
  图表基类
}
