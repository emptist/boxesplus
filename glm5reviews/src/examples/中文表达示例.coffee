#!/usr/bin/env coffee

# 大道至简的中文表达
# 不文艺，但简洁明了

{创作, 流程, 结构, 关系, 图, 完成} = require "../code/中文表达.coffee"

# ============================================
# 示例：用最自然的方式表达复杂概念
# ============================================

创作 "中文表达示例"

# 流程：用自然语言
图
  标题: "战略管理闭环"
  步骤: ["战略规划", "年度预算", "绩效考核", "运营调整"]
  循环: true
  说明: "战略规划是起点，运营调整反馈到下一轮规划"

# 结构：用层级描述
图
  标题: "医院组织架构"
  层级: [
    "院长"
    "副院长"
    "职能科室"
    "临床科室"
  ]

# 关系：用对比表达
图
  标题: "战略思维 vs 战术思维"
  类型: "对比"
  左侧: "战略思维\n3-5年\n方向性"
  右侧: "战术思维\n短期\n操作性"

# 并列关系
图
  标题: "新时期医院面临的挑战"
  类型: "并列"
  项目: [
    "DRG/DIP支付改革"
    "公立医院绩效考核"
    "分级诊疗"
    "数字化转型"
  ]

# 因果关系
图
  标题: "DRG对医院的影响"
  类型: "因果"
  原因: "按病种付费"
  结果: "从收入中心转为成本中心"

完成 "../../output/中文表达示例.pptx"
