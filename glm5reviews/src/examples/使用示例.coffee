#!/usr/bin/env coffee

# BoxesPlus 统一API使用示例
# 展示四种不同层级的API

boxesplus = require "../code/boxesplus.coffee"

console.log "\n=== BoxesPlus v#{boxesplus.版本} 使用示例 ===\n"

# ============================================
# 示例1：中文API（推荐用于一般场景）
# ============================================

console.log "示例1：中文API"

boxesplus.中文
  .开始 "A01医院管理总览课程"
  .封面页 "医院管理总览", "体系、趋势与中国特色"
  .章节页 "第一篇", "医院管理导论", "理解医院管理的全貌"
  .列表页 "课程目标", [
    "知识目标：掌握医疗健康服务体系演进"
    "能力目标：从宏观视角审视医院管理"
    "素质目标：培养战略思维与全局观念"
  ]
  .结束 "../../output/示例1-中文API.pptx"

# ============================================
# 示例2：诗式API（推荐用于快速创作）
# ============================================

console.log "\n示例2：诗式API"

boxesplus.诗式
  .创作 "A02战略规划课程大纲"
  .诗 [
    "医院战略管理课程"
    "从规模扩张到高质量发展"
  ]
  .诗 [
    "第一模块"
    "战略管理导论"
    "建立战略思维框架"
  ]
  .诗 [
    "1.1 战略管理的本质"
    """
    从规模扩张到高质量发展的转型
    战略思维 vs 战术思维
    战略管理闭环：战略-预算-绩效-运营
    """
  ]
  .完成 "../../output/示例2-诗式API.pptx"

# ============================================
# 示例3：双侧编程API（推荐用于复杂项目）
# ============================================

console.log "\n示例3：双侧编程API"

{课程幻灯片} = boxesplus

课程 = boxesplus.双侧.开始 "B01组织架构课程大纲"

课程
  .添加 课程幻灯片.封面 "医院组织架构与职能配置", "组织的「骨骼系统」"
  .添加 课程幻灯片.章节 "第一章", "组织架构概述", "理解组织的「权力地图」"
  .添加 课程幻灯片.列表 "1.1 什么是组织架构", [
    "权力地图：谁向谁汇报"
    "分工网络：谁负责什么"
    "决策通道：指令怎么传"
  ]
  .完成 "../../output/示例3-双侧编程API.pptx"

# ============================================
# 示例4：便捷方法（最简单）
# ============================================

console.log "\n示例4：便捷方法"

boxesplus.便捷方法.开始 "D01学科建设课程"
  .封面页 "学科建设与专科发展", "医院的「立院之本」"
  .章节页 "第一章", "学科建设概述", "理解学科建设的意义"
  .列表页 "1.1 学科建设的意义", [
    "学科是医院的立院之本"
    "学科强则医院强"
    "学科特色就是竞争力"
  ]
  .结束 "../../output/示例4-便捷方法.pptx"

console.log "\n=== 所有示例已完成 ===\n"
