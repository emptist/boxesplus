#!/usr/bin/env coffee

# 双侧编程实战：课程大纲生成器
# 类一侧：定义课程结构和规则
# 实例一侧：填充具体课程内容

{幻灯片, 演示文稿, 开始} = require "../code/双侧编程.coffee"

# ============================================
# 类一侧扩展：课程专用类
# ============================================

class 课程幻灯片 extends 幻灯片
  # 类一侧：课程特定的模板
  @课程模板:
    封面:
      类型: "封面"
      颜色: "2B579A"
    章节:
      类型: "章节"
      颜色: "2B579A"
    知识点:
      类型: "列表"
      颜色: "2B579A"
  
  # 类方法：快速创建封面
  @封面: (标题, 副标题) ->
    new @
      类型: "封面"
      标题: 标题
      内容: 副标题
  
  # 类方法：快速创建章节
  @章节: (编号, 标题, 副标题) ->
    new @
      类型: "章节"
      编号: 编号
      标题: 标题
      内容: 副标题
  
  # 类方法：快速创建知识点
  @知识点: (标题, 内容列表) ->
    new @
      类型: "列表"
      标题: 标题
      内容: 内容列表
  
  # 类方法：快速创建流程
  @流程: (标题, 步骤列表) ->
    new @
      类型: "流程"
      标题: 标题
      内容: 步骤列表
  
  # 类方法：快速创建结构
  @结构: (标题, 层级列表) ->
    new @
      类型: "结构"
      标题: 标题
      内容: 层级列表

# ============================================
# 实例一侧：具体课程内容
# ============================================

课程 = 开始 "A02战略规划课程大纲"

# 使用类方法快速创建
课程.幻灯片列表.push 课程幻灯片.封面 "医院战略管理课程", "从规模扩张到高质量发展"

课程.幻灯片列表.push 课程幻灯片.知识点 "课程定位", [
  "对象：医院高层管理者、中层干部、科室主任"
  "时长：12小时（可压缩至6小时）"
  "方法：理论讲授、工具演练、案例分析、课堂讨论"
]

# 第一模块
课程.幻灯片列表.push 课程幻灯片.章节 "第一模块", "战略管理导论", "建立战略思维框架"

课程.幻灯片列表.push 课程幻灯片.知识点 "1.1 战略管理的本质与价值", [
  "从规模扩张到高质量发展的转型"
  "战略思维 vs 战术思维"
  "战略管理闭环：战略-预算-绩效-运营"
]

课程.幻灯片列表.push 课程幻灯片.流程 "战略管理闭环", [
  "战略规划"
  "年度预算"
  "绩效考核"
  "运营调整"
]

课程.幻灯片列表.push 课程幻灯片.知识点 "1.2 新时期的挑战与机遇", [
  "DRG/DIP支付改革冲击"
  "公立医院绩效考核（国考）导向"
  "分级诊疗与区域医疗中心建设"
  "数字化转型与智慧医院建设"
]

# 第二模块
课程.幻灯片列表.push 课程幻灯片.章节 "第二模块", "战略分析工具与方法", "掌握分析框架"

课程.幻灯片列表.push 课程幻灯片.知识点 "2.1 外部环境分析", [
  "PESTEL+分析法"
  "区域医疗竞争格局分析"
  "患者需求与就医行为变化"
]

课程.幻灯片列表.push 课程幻灯片.结构 "PESTEL分析框架", [
  "政治环境 (Political)"
  "经济环境 (Economic)"
  "社会环境 (Social)"
  "技术环境 (Technological)"
  "环境因素 (Environmental)"
  "法律因素 (Legal)"
]

# 第三模块
课程.幻灯片列表.push 课程幻灯片.章节 "第三模块", "战略规划制定", "从分析到规划"

课程.幻灯片列表.push 课程幻灯片.知识点 "3.1 战略定位与愿景设计", [
  "差异化定位策略"
  "专科布局与学科建设规划"
  "区域医疗中心建设路径"
]

# 保存
课程.保存 "../../output/A02课程大纲-双侧编程版.pptx"
