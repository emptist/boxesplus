    new @ 类型: "封面", 标题: 标题, 内容: 副标题
  
  @章节: (编号, 标题, 副标题) ->
    new @ 类型: "章节", 编号: 编号, 标题: 标题, 内容: 副标题
  
  @知识点: (标题, 内容列表) ->
    new @ 类型: "列表", 标题: 标题, 内容: 内容列表
  
  @流程: (标题, 步骤列表) ->
    new @ 类型: "流程", 标题: 标题, 内容: 步骤列表
  
  @结构: (标题, 层级列表) ->
