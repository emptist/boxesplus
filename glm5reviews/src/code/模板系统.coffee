#!/usr/bin/env coffee

# PPTX深度探索：模板系统
# 目标：发现可复用的模式

fs = require "fs"
PptxGenJS = require "pptxgenjs"

# ============================================
# 核心洞察：模板是预定义的渲染指令
# ============================================

class 模板系统
  @模板库: {}
  
  # 注册模板
  @注册: (名称, 模板定义) ->
    @模板库[名称] = 模板定义
    console.log "✅ 注册模板：#{名称}"
  
  # 获取模板
  @获取: (名称) ->
    unless @模板库[名称]
      throw new Error "❌ 模板不存在：#{名称}"
    @模板库[名称]
  
  # 列出所有模板
  @列表: ->
    Object.keys @模板库

# ============================================
# 预定义课程模板
# ============================================

# 封面模板
模板系统.注册 "课程封面",
  类型: "封面"
  布局:
    标题:
      x: 0.5, y: 2, w: 9, h: 1.5
      fontSize: 44, bold: true, color: "2B579A", align: "center"
    副标题:
      x: 0.5, y: 3.5, w: 9, h: 0.8
      fontSize: 24, color: "666666", align: "center"
  默认值:
    颜色: "2B579A"

# 章节模板
模板系统.注册 "课程章节",
  类型: "章节"
  布局:
    编号:
      x: 0.5, y: 1.5, w: 9, h: 0.8
      fontSize: 20, color: "999999", align: "center"
    标题:
      x: 0.5, y: 2.2, w: 9, h: 1.2
      fontSize: 40, bold: true, color: "2B579A", align: "center"
    副标题:
      x: 0.5, y: 3.4, w: 9, h: 0.6
      fontSize: 18, color: "666666", align: "center"

# 列表模板
模板系统.注册 "课程列表",
  类型: "列表"
  布局:
    标题:
      x: 0.5, y: 0.3, w: 9, h: 0.7
      fontSize: 28, bold: true, color: "2B579A"
    内容:
      x: 0.5, y: 1.2, w: 9, h: 4
      fontSize: 16

# 流程模板
模板系统.注册 "课程流程",
  类型: "流程"
  布局:
    标题:
      x: 0.5, y: 0.3, w: 9, h: 0.7
      fontSize: 28, bold: true, color: "2B579A"
    步骤框:
      高度: 0.8
      y坐标: 1.5
      颜色: "2B579A"
    箭头:
      fontSize: 20
      color: "2B579A"

# ============================================
# 模板渲染器
# ============================================

class 模板渲染器
  constructor: (@pptx) ->
  
  渲染: (模板名, 数据) ->
    模板 = 模板系统.获取 模板名
    slide = @pptx.addSlide()
    
    switch 模板.类型
      when "封面"
        @渲染封面 slide, 模板, 数据
      when "章节"
        @渲染章节 slide, 模板, 数据
      when "列表"
        @渲染列表 slide, 模板, 数据
      when "流程"
        @渲染流程 slide, 模板, 数据
  
  渲染封面: (slide, 模板, 数据) ->
    {标题, 副标题} = 数据
    
    布局 = 模板.布局
    颜色 = 数据.颜色 ? 模板.默认值.颜色
    
    slide.addText 标题,
      Object.assign {}, 布局.标题, {color: 颜色}
    
    if 副标题
      slide.addText 副标题, 布局.副标题
  
  渲染章节: (slide, 模板, 数据) ->
    {编号, 标题, 副标题} = 数据
    布局 = 模板.布局
    
    if 编号
      slide.addText 编号, 布局.编号
    
    slide.addText 标题, 布局.标题
    
    if 副标题
      slide.addText 副标题, 布局.副标题
  
  渲染列表: (slide, 模板, 数据) ->
    {标题, 项目列表} = 数据
    布局 = 模板.布局
    
    slide.addText 标题, 布局.标题
    
    文本列表 = 项目列表.map (项, i) ->
      text: "#{i + 1}. #{项}\n"
      options: fontSize: 布局.内容.fontSize, breakLine: true
    
    slide.addText 文本列表, 布局.内容
  
  渲染流程: (slide, 模板, 数据) ->
    {标题, 步骤列表, 循环} = 数据
    布局 = 模板.布局
    
    slide.addText 标题, 布局.标题
    
    步骤数 = 步骤列表.length
    步骤宽度 = 8 / 步骤数
    
    for 步骤, 索引 in 步骤列表
      x = 1 + 索引 * 步骤宽度
      
      slide.addShape "rect",
        x: x
        y: 布局.步骤框.y坐标
        w: 步骤宽度 - 0.3
        h: 布局.步骤框.高度
        fill: { color: 布局.步骤框.颜色 }
      
      slide.addText 步骤,
        x: x
        y: 布局.步骤框.y坐标 + 0.1
        w: 步骤宽度 - 0.3
        h: 布局.步骤框.高度 - 0.2
        fontSize: 14
        color: "FFFFFF"
        align: "center"
        bold: true
      
      if 索引 < 步骤数 - 1
        slide.addText "→",
          x: x + 步骤宽度 - 0.3
          y: 布局.步骤框.y坐标 + 0.1
          w: 0.3
          h: 布局.步骤框.高度 - 0.2
          fontSize: 布局.箭头.fontSize
          color: 布局.箭头.color
          align: "center"

# ============================================
# 使用示例
# ============================================

console.log "\n=== 模板系统探索 ===\n"

pptx = new PptxGenJS()
pptx.layout = "LAYOUT_16x9"

渲染器 = new 模板渲染器 pptx

# 使用模板
渲染器.渲染 "课程封面",
  标题: "医院管理课程"
  副标题: "体系、趋势与中国特色"

渲染器.渲染 "课程章节",
  编号: "第一篇"
  标题: "医院管理导论"
  副标题: "理解医院管理的全貌"

渲染器.渲染 "课程列表",
  标题: "课程目标"
  项目列表: [
    "知识目标：掌握医疗健康服务体系演进"
    "能力目标：从宏观视角审视医院管理"
    "素质目标：培养战略思维与全局观念"
  ]

渲染器.渲染 "课程流程",
  标题: "战略管理闭环"
  步骤列表: ["战略规划", "年度预算", "绩效考核", "运营调整"]
  循环: true

pptx.writeFile({ fileName: "output/模板系统示例.pptx" })
  .then ->
    console.log "✅ 生成完成"
    console.log "\n可用模板："
    模板系统.列表().forEach (名称) ->
      console.log "  - #{名称}"

# ============================================
# 反思：模板系统的价值
# ============================================

反思 = """
=== 反思：模板系统的价值 ===

1. 分离关注点
   - 模板定义：布局、样式、默认值
   - 数据填充：具体内容
   - 渲染逻辑：如何绘制

2. 提高复用性
   - 一次定义，多次使用
   - 统一风格，保证一致性

3. 降低门槛
   - 用户不需要了解坐标、样式
   - 只需要提供内容数据

4. 易于维护
   - 修改模板，所有使用处都更新
   - 不需要逐个修改

5. 可扩展
   - 轻松添加新模板
   - 支持自定义模板

核心模式：
  模板定义 + 数据填充 = 最终输出

这个模式可以应用到：
  - PPTX生成
  - RevealJS生成
  - 网页生成
  - 文档生成
  - ...
"""

console.log "\n#{反思}"

module.exports = {
  模板系统
  模板渲染器
}
