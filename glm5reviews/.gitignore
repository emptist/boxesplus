# GLM5 Reviews - Gitignore

# Ignore all files in glm5reviews folder (reviewer workspace)
# This allows the reviewer to work independently without affecting the main project

# All markdown files (except documentation)
*.md
!README.md
!.trae/**/*.md

# All JSON files (except package.json)
*.json
!package.json

# All generated files
*.pptx
*.html
*.pdf

# Mermaid related files (experimental, not used by main developer)
*mermaid*.html
*mermaid*.svg
*mermaid*.png
*.mermaid

# Sensitive files
*.env
*.env.local
*.secret
*.key
*.pem

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log

# Node modules (if any)
node_modules/

# Coverage reports
coverage/

# Build outputs
dist/
outputs/
output/
