    class 临床路径指标 extends NumberSlide
        @入径率: "≥70%"
        @完成率: "≥80%"
        @变异率: "≤10%"

## 第四章

    class 第四章封面 extends SectionSlide
        @编号: "04"
        @副标题: "患者安全目标与措施（1.5小时）"

    class 患者安全目标 extends ContentSlide
        @目标一: "正确识别患者身份"
        @目标二: "确保用药与用血安全"
        @目标三: "强化围手术期安全管理"
        @目标四: "加强有效沟通"
        @目标五: "落实临床危急值管理制度"

    class 患者安全目标续 extends ContentSlide
        @目标六: "预防和减少医院相关性感染"
        @目标七: "加强孕产妇及新生儿安全"
