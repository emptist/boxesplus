        @目标九: "识别患者安全风险"
        @目标十: "加强医学装备及医院信息安全管理"

    class 目标一详解 extends ContentSlide
        @要求1: "至少使用两种患者身份识别方式"
        @要求2: "姓名+住院号/出生日期等"
