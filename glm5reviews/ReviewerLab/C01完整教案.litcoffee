## 第三章

    class 第三章封面 extends SectionSlide
        @编号: "03"
        @副标题: "质量管理工具与方法（2小时）"

    class PDCA循环 extends ProcessSlide
        @步骤: [
            {名称: "PLAN", 描述: "分析现状、找问题、分析原因、制定计划"}
            {名称: "DO", 描述: "实施计划、落实措施"}
            {名称: "CHECK", 描述: "检查效果、发现问题"}
            {名称: "ACTION", 描述: "总结经验、标准化、遗留问题入下轮"}
        ]

    class PDCA特点 extends ContentSlide
        @特点1: "大环套小环"
        @特点2: "不断循环"
        @特点3: "持续改进"

    class 质量管理工具 extends TableSlide
        @工具1: "鱼骨图|分析问题原因|人、机、料、法、环、测"
        @工具2: "流程图|描述过程步骤|流程图、泳道图"
        @工具3: "柏拉图|找出主要问题|二八法则"

    class 柏拉图原理 extends ContentSlide
        @用途: "找出主要问题"
        @原理: "80%问题由20%原因导致"
        @步骤: "收集数据 → 排序统计 → 绘制图表 → 找出关键少数"

    class 临床路径概念 extends TableSlide
        @要素1: "定义|标准化诊疗流程"
        @要素2: "目标|规范诊疗、保证质量、控制费用"
