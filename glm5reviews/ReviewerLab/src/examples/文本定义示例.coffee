console.log "\n=== 方式2：JSON定义 ===\n"

# 解析JSON定义
pptx = new (require "pptxgenjs")()
pptx.layout = "LAYOUT_16x9"

{生成渲染指令, 渲染页面} = require "../code/JSON定义解析.coffee"

课程定义2.forEach (定义) ->
  指令 = 生成渲染指令 定义
  渲染页面 pptx, 指令

pptx.writeFile({ fileName: "../../output/文本定义-JSON式.pptx" })
  .then ->
    console.log "✅ JSON定义方式完成"

