  ["课程信息", """
    课程定位：医疗健康养老机构管理课程体系导论
    课程时长：12小时（2天）
    课程对象：医院院长、中高层管理者
  """]
  
  ["第一篇", "纵览古今", "人类健康与医疗服务演进"]
  
  ["人类健康观念的演变", """
    从「治病」到「治未病」的理念变迁
    健康定义的演化：生物医学→社会心理→生物-心理-社会
    疾病谱变化：传染病→慢性病→复杂多因素疾病
  """]
  
  {
    标题: "战略管理闭环"
    步骤: ["战略规划", "年度预算", "绩效考核", "运营调整"]
    循环: true
  }
  
  {
    标题: "医院组织架构"
    层级: ["院长", "副院长", "职能科室", "临床科室"]
