#!/usr/bin/env coffee

# B01 组织架构课程大纲 - 双侧编程版
# 类一侧：课程幻灯片类
# 实例一侧：具体课程内容

{幻灯片, 演示文稿, 开始} = require "../code/双侧编程.coffee"

# ============================================
# 扩展课程幻灯片类
# ============================================

class 课程幻灯片 extends 幻灯片
  @封面: (标题, 副标题) ->
    new @ 类型: "封面", 标题: 标题, 内容: 副标题
  
  @章节: (编号, 标题, 副标题) ->
    new @ 类型: "章节", 编号: 编号, 标题: 标题, 内容: 副标题
  
  @知识点: (标题, 内容列表) ->
    new @ 类型: "列表", 标题: 标题, 内容: 内容列表
  
  @流程: (标题, 步骤列表) ->
    new @ 类型: "流程", 标题: 标题, 内容: 步骤列表
  
  @结构: (标题, 层级列表) ->
    new @ 类型: "结构", 标题: 标题, 内容: 层级列表

# ============================================
# 实例一侧：B01 课程内容
# ============================================

课程 = 开始 "B01组织架构与职能配置课程大纲"

课程.幻灯片列表.push 课程幻灯片.封面 "医院组织架构与职能配置", "组织的「骨骼系统」"

课程.幻灯片列表.push 课程幻灯片.知识点 "课程定位", [
  "对象：医院院长、分管副院长、人力资源部主任"
  "背景：医改深入、DRG/DIP、绩效考核、多院区管理"
  "目标：诊断问题、设计方案、推进变革"
]

# 第一章
课程.幻灯片列表.push 课程幻灯片.章节 "第一章", "组织架构概述", "理解组织的「权力地图」"

课程.幻灯片列表.push 课程幻灯片.知识点 "1.1 什么是组织架构", [
  "权力地图：谁向谁汇报"
  "分工网络：谁负责什么"
  "决策通道：指令怎么传"
]

课程.幻灯片列表.push 课程幻灯片.知识点 "1.2 组织架构类型", [
  "直线型：院长直接管科室，简单高效"
  "直线职能型：职能科室设置，最常见"
  "矩阵型：双重管理，适合多院区"
  "委员会制：专家决策，三甲标配"
]

课程.幻灯片列表.push 课程幻灯片.知识点 "1.3 设计原则", [
  "精简高效：机构不求多，够用就好"
  "权责对等：有权必有责，有责必有权"
  "适应发展：现在适用，未来也适用"
  "因地制宜：适合别人的不一定适合你"
]

# 第二章
课程.幻灯片列表.push 课程幻灯片.章节 "第二章", "职能科室配置", "核心部门怎么设置"

课程.幻灯片列表.push 课程幻灯片.知识点 "2.1 医疗管理类", [
  "医务科：医疗业务的中枢神经"
  "护理部：护理管理的大脑"
  "质控科：质量控制的守门员"
  "院感科：感染防控的防火墙"
  "门诊部：门诊管理的大管家"
]

课程.幻灯片列表.push 课程幻灯片.知识点 "2.2 综合管理类", [
  "院办：院长办公会的秘书处"
  "党办：党建工作的执行者"
  "人事科：人力资源的大管家"
  "财务科：医院财务的钱袋子"
  "科教科：科研教学的推动者"
  "医保办：医保管理的对接人"
]

课程.幻灯片列表.push 课程幻灯片.知识点 "2.3 后勤保障类", [
  "总务科：后勤保障的大后勤"
  "设备科：医疗设备的维护者"
  "信息科：信息化建设的技术支撑"
  "保卫科：安全管理的守护者"
]

课程.幻灯片列表.push 课程幻灯片.结构 "医院组织架构", [
  "院长"
  "副院长"
  "职能科室"
  "临床科室"
]

# 第三章
课程.幻灯片列表.push 课程幻灯片.章节 "第三章", "多院区组织管理", "应对多院区挑战"

课程.幻灯片列表.push 课程幻灯片.知识点 "3.1 多院区模式", [
  "管理：紧密型、松散型、hybrid"
  "职能：核心统一、辅助分设"
  "定位：同质化还是差异化"
  "沟通：例会制度、信息化、交叉任职"
]

# 第四章
课程.幻灯片列表.push 课程幻灯片.章节 "第四章", "组织变革", "什么时候变、怎么变"

课程.幻灯片列表.push 课程幻灯片.知识点 "4.1 变革动因", [
  "外部：政策要求、竞争压力、技术进步"
  "内部：规模扩大、学科调整、战略转型"
  "问题：效率低下、推诿扯皮、反应迟钝"
]

课程.幻灯片列表.push 课程幻灯片.知识点 "4.2 变革策略", [
  "渐进式：小步快跑、风险小"
  "激进式：大刀阔斧、效果快"
  "阻力：习惯势力、利益调整、认知差异"
  "关键：沟通到位、试点先行、配套跟上"
]

# 第五章
课程.幻灯片列表.push 课程幻灯片.章节 "第五章", "案例研讨与实操", "检验学习成果"

课程.幻灯片列表.push 课程幻灯片.知识点 "案例与练习", [
  "案例：某三甲医院组织架构优化"
  "案例：某县级医院多院区管理架构设计"
  "练习：职能科室职责梳理"
  "练习：组织架构优化方案设计"
]

# 工具箱
课程.幻灯片列表.push 课程幻灯片.知识点 "管理工具箱", [
  "职能科室职责说明书模板"
  "组织架构图绘制模板"
  "部门职责交叉分析表"
  "组织变革风险评估表"
]

课程.保存 "../../output/B01课程大纲-双侧编程版.pptx"
