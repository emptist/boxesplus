#!/usr/bin/env coffee

# 双侧编程风格示例 - C01医疗质量与安全管理课程
# 类一侧：定义图表模板和规则
# 实例一侧：填充具体内容

{ 开始绘图, 完成绘图, 创建流程图, 创建时序图, 创建类图, 创建状态图, 图表容器, 流程图, 时序图, 类图, 状态图 } = require "../api/mermaid-enhanced.coffee"

# ============================================
# 第一层：图表模板类（类一侧）
# ============================================

class 质量管理流程图 extends 流程图
  @模板:
    方向: "TD"
    节点样式:
      开始: 形状: "圆角"
      决策: 形状: "菱形"
      结束: 形状: "圆柱"
  
  @创建: (标题) ->
    图表 = new @ 标题
    图表.设置方向 @模板.方向
    图表

# ============================================
# 第二层：具体图表（实例一侧）
# ============================================

# PDCA循环图
PDCA循环 = 质量管理流程图.创建 "PDCA持续改进循环"
PDCA循环.添加节点 "P", "PLAN\n分析现状\n找问题\n制定计划", 质量管理流程图.模板.节点样式.开始
PDCA循环.添加节点 "D", "DO\n实施计划\n落实措施", 质量管理流程图.模板.节点样式.开始
PDCA循环.添加节点 "C", "CHECK\n检查效果\n发现问题", 质量管理流程图.模板.节点样式.开始
PDCA循环.添加节点 "A", "ACTION\n总结经验\n标准化\n遗留问题入下轮", 质量管理流程图.模板.节点样式.结束

PDCA循环.添加连接 "P", "D"
PDCA循环.添加连接 "D", "C"
PDCA循环.添加连接 "C", "A"
PDCA循环.添加连接 "A", "P", "持续改进"

# 质量管理体系架构图
体系架构 = 创建流程图 "医疗质量管理体系三层架构"
体系架构.设置方向 "TB"

体系架构.添加子图 "第一层：顶层设计", [
  { id: "方针", 文本: "质量方针" }
  { id: "目标", 文本: "质量目标" }
  { id: "文化", 文本: "质量文化" }
]

体系架构.添加子图 "第二层：组织保障", [
  { id: "组织", 文本: "质量组织" }
  { id: "制度", 文本: "质量制度" }
  { id: "流程", 文本: "质量流程" }
]

体系架构.添加子图 "第三层：执行控制", [
  { id: "控制", 文本: "质量控制" }
  { id: "保证", 文本: "质量保证" }
  { id: "改进", 文本: "质量改进" }
]

体系架构.添加连接 "方针", "组织"
体系架构.添加连接 "目标", "制度"
体系架构.添加连接 "文化", "流程"
体系架构.添加连接 "组织", "控制"
体系架构.添加连接 "制度", "保证"
体系架构.添加连接 "流程", "改进"

# 不良事件闭环管理
事件管理 = 创建流程图 "不良事件闭环管理流程"
事件管理.设置方向 "TD"

事件管理.添加节点 "报告", "1.事件报告", 形状: "圆角"
事件管理.添加节点 "调查", "2.初步调查", 形状: "圆角"
事件管理.添加节点 "分析", "3.根本原因分析", 形状: "菱形"
事件管理.添加节点 "改进", "4.改进措施", 形状: "圆角"
事件管理.添加节点 "评估", "5.效果评估", 形状: "圆角"
事件管理.添加节点 "标准", "6.标准化", 形状: "圆柱"

事件管理.添加连接 "报告", "调查"
事件管理.添加连接 "调查", "分析"
事件管理.添加连接 "分析", "改进"
事件管理.添加连接 "改进", "评估"
事件管理.添加连接 "评估", "标准"

# ============================================
# 时序图：危急值管理
# ============================================

危急值管理 = 创建时序图 "危急值管理全流程"
危急值管理.添加参与者 "检验科", "检验"
危急值管理.添加参与者 "信息系统", "系统"
危急值管理.添加参与者 "临床科室", "临床"
危急值管理.添加参与者 "质控部门", "质控"

危急值管理.添加消息 "检验科", "信息系统", "检测到危急值", "同步"
危急值管理.添加消息 "信息系统", "临床科室", "发送危急值报告", "同步"
危急值管理.添加消息 "临床科室", "信息系统", "确认接收", "返回"
危急值管理.添加消息 "临床科室", "信息系统", "记录处理措施", "同步"
危急值管理.添加消息 "信息系统", "质控部门", "上报事件", "同步"
危急值管理.添加消息 "质控部门", "临床科室", "审核确认", "返回"

# ============================================
# 类图：质量管理组织
# ============================================

质量管理组织 = 创建类图 "质量管理组织架构"

质量管理组织.添加类 "质量委员会",
  ["主席", "委员", "秘书"],
  ["制定质量方针", "审核质量目标", "决策重大事项"]

质量管理组织.添加类 "质控部门",
  ["主任", "质控员", "数据分析师"],
  ["日常监督检查", "质量数据分析", "问题跟踪整改"]

质量管理组织.添加类 "科室质控组",
  ["组长", "质控员"],
  ["科室自查自纠", "问题分析改进", "质量指标监测"]

质量管理组织.添加类 "全院职工",
  ["医师", "护士", "技师"],
  ["执行诊疗规范", "报告不良事件", "参与质量改进"]

质量管理组织.添加关系 "质量委员会", "质控部门", "关联"
质量管理组织.添加关系 "质控部门", "科室质控组", "关联"
质量管理组织.添加关系 "科室质控组", "全院职工", "关联"

# ============================================
# 状态图：患者安全风险管理
# ============================================

安全风险管理 = 创建状态图 "患者安全风险管理状态机"

安全风险管理.添加状态 "正常状态", "普通"
安全风险管理.添加状态 "风险评估", "普通"
安全风险管理.添加状态 "高风险状态", "普通"
安全风险管理.添加状态 "干预措施", "普通"
安全风险管理.添加状态 "安全状态", "结束"

安全风险管理.添加转换 "正常状态", "风险评估", "定期评估"
安全风险管理.添加转换 "风险评估", "高风险状态", "发现风险"
安全风险管理.添加转换 "高风险状态", "干预措施", "启动干预"
安全风险管理.添加转换 "干预措施", "安全状态", "风险消除"
安全风险管理.添加转换 "安全状态", "正常状态", "恢复常态"

# ============================================
# 批量创建和保存
# ============================================

绘图 = 开始绘图 "C01医疗质量与安全管理课程图表集"

绘图
  .添加 PDCA循环
  .添加 体系架构
  .添加 事件管理
  .添加 危急值管理
  .添加 质量管理组织
  .添加 安全风险管理

完成绘图 "../output/C01课程图表-双侧编程版.md"
