#!/usr/bin/env coffee

# C01医疗质量与安全管理课程 - PPTX生成
# 基于教案，使用成熟API，简单内容直接做PPTX，复杂内容用图片嵌入

fs = require "fs"
path = require "path"
Puppeteer = require "puppeteer"

# 导入boxesplus成熟API
{ 中文, 诗式 } = require "../../src/code/boxesplus.coffee"
{ 开始绘图, 流程图, 时序图, 类图, 状态图 } = require "../api/mermaid-user-friendly.coffee"

# ============================================
# 配置
# ============================================

输出目录 = path.join __dirname, "../output"
PPTX文件名 = path.join 输出目录, "C01医疗质量与安全管理课程-完整版.pptx"

# ============================================
# 辅助函数
# ============================================

确保输出目录存在 = ->
  unless fs.existsSync 输出目录
    fs.mkdirSync 输出目录, recursive: true

生成Mermaid图片 = (图表描述, 文件名, 回调) ->
  console.log "  生成Mermaid图片: #{文件名}"
  
  临时HTML = path.join 输出目录, "temp-#{文件名}.html"
  图片路径 = path.join 输出目录, "#{文件名}.png"
  
  临时演示 = 开始绘图 "临时"
  临时演示.添加图表 图表描述
  临时演示.完成 临时HTML
  
  完成回调 = if typeof 回调 == 'function' then 回调 else ->
  
  Puppeteer.launch({
    headless: true,
    executablePath: '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
  }).then (browser) ->
    browser.newPage().then (page) ->
      page.goto("file://#{path.resolve 临时HTML}", { waitUntil: 'load', timeout: 60000 }).then ->
        setTimeout ->
          page.$('.mermaid').then (element) ->
            if element
              element.screenshot({ path: 图片路径 }).then ->
                console.log "  ✅ 图片生成完成"
                browser.close()
                完成回调()
            else
              console.error "  未找到Mermaid元素"
              browser.close()
              完成回调()
        , 5000
    .catch (错误) ->
      console.error "  生成图片失败:", 错误.message
      browser.close()
      完成回调()

# ============================================
# 主程序
# ============================================

